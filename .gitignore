# belongs in the repo (see .claude/skills/run-overwatch/ for an example).
.claude/*
!.claude/skills/
.claude/skills/*/node_modules/
.claude/skills/*/out/
.factory/

# Mirrored Cesium runtime assets (regenerated by predev / prebuild).
