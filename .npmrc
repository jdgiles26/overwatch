auto-install-peers=true
strict-peer-dependencies=false
node-linker=isolated
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Allow install scripts for this project (overrides a global ignore-scripts=true
# in ~/.npmrc). Combined with the explicit allowlist in pnpm-workspace.yaml,
# only the trusted native packages run build scripts.
ignore-scripts=false
