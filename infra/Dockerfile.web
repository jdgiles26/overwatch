FROM node:22-bookworm-slim AS deps
WORKDIR /app
ENV CI=true
COPY package.json pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/schemas/package.json packages/schemas/
RUN corepack enable && corepack prepare pnpm@11.2.2 --activate
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
# NEXT_PUBLIC_* are inlined into the browser bundle at build time.
ARG NEXT_PUBLIC_FABRIC_URL=http://localhost:4311
ARG NEXT_PUBLIC_FABRIC_WS=ws://localhost:4311
ARG NEXT_PUBLIC_GO2RTC_URL=http://localhost:1984
ENV NEXT_PUBLIC_FABRIC_URL=$NEXT_PUBLIC_FABRIC_URL
ENV NEXT_PUBLIC_FABRIC_WS=$NEXT_PUBLIC_FABRIC_WS
ENV NEXT_PUBLIC_GO2RTC_URL=$NEXT_PUBLIC_GO2RTC_URL
# FABRIC_URL is consumed by next.config.mjs rewrites at build time. Inside
# the Docker stack the web service reaches fabric over the compose network
# at http://fabric:4311; default to that here so the baked proxy rule
# resolves to the right host. Override per-deploy with --build-arg.
ARG FABRIC_URL=http://fabric:4311
ENV FABRIC_URL=$FABRIC_URL
COPY . .
RUN pnpm --filter=@overwatch/web build

FROM node:22-bookworm-slim AS run
WORKDIR /app
ENV CI=true
COPY --from=build /app /app
RUN corepack enable && corepack prepare pnpm@11.2.2 --activate
# Re-export so the running server (which re-evaluates `next.config.mjs`
# on startup in non-standalone mode) sees the same value.
ARG FABRIC_URL=http://fabric:4311
ENV NODE_ENV=production FABRIC_URL=$FABRIC_URL
EXPOSE 3311
CMD ["pnpm", "--filter=@overwatch/web", "start"]
