FROM node:22-bookworm-slim AS deps
RUN apt-get update && apt-get install -y python3 build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# CI=true tells pnpm not to prompt (or wipe node_modules) when it detects
# the packageManager pin doesn't match what's already on disk. Without it
# every `pnpm` invocation in the runtime container fails with
# ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY.
ENV CI=true
COPY package.json pnpm-workspace.yaml tsconfig.base.json .npmrc ./
COPY apps/fabric/package.json apps/fabric/
COPY packages/connectors/package.json packages/connectors/
COPY packages/schemas/package.json packages/schemas/
# Pin to the same pnpm version as root packageManager — version drift triggers
# pnpm's deps-status check, which tries to wipe + reinstall on every run.
RUN corepack enable && corepack prepare pnpm@11.2.2 --activate
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
COPY . .

FROM node:22-bookworm-slim AS run
WORKDIR /app
ENV CI=true
COPY --from=build /app /app
RUN corepack enable && corepack prepare pnpm@11.2.2 --activate
ENV NODE_ENV=production
EXPOSE 4311
CMD ["pnpm", "--filter=@overwatch/fabric", "start"]
